  "components": [
    {
      "name": "Confirm Button",
      "kind": "button",
      "refersTo": "button-confirm",
      "description": "검토를 마치고 확정하는 유일한 주 동작. 사이드바 폭 전체 알약형.",
      "html": "<button class=\"ds-btn-confirm\">확정하고 내보내기</button>",
      "css": ".ds-btn-confirm{font-family:-apple-system, \"Geist\", \"Inter\", \"Pretendard\", \"Apple SD Gothic Neo\", sans-serif;width:260px;background:#0070f3;color:#fff;border:none;border-radius:9999px;font-weight:600;font-size:13.5px;padding:10px 9px;cursor:pointer;transition:filter 120ms ease}.ds-btn-confirm:hover{filter:brightness(1.06)}.ds-btn-confirm:focus-visible{outline:none;box-shadow:0 0 0 2px #fff,0 0 0 4px #0070f3}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "모달의 취소·닫기·로그 복사.",
      "html": "<button class=\"ds-btn-secondary\">닫기</button>",
      "css": ".ds-btn-secondary{font-family:-apple-system, \"Geist\", \"Inter\", \"Pretendard\", \"Apple SD Gothic Neo\", sans-serif;padding:7px 14px;border-radius:8px;border:1px solid #ebebeb;background:#fafafa;color:#171717;font-size:13px;cursor:pointer;transition:border-color 120ms ease}.ds-btn-secondary:hover{border-color:#a1a1a1}.ds-btn-secondary:focus-visible{outline:none;border-color:#0070f3;box-shadow:0 0 0 2px #d3e5ff}"
    },
    {
      "name": "Icon Button",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "되돌리기·다시 실행·도움말 같은 원형 아이콘 버튼.",
      "html": "<button class=\"ds-btn-icon\" aria-label=\"되돌리기\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 14 4 9l5-5\"/><path d=\"M4 9h10.5a5.5 5.5 0 0 1 0 11H11\"/></svg></button>",
      "css": ".ds-btn-icon{width:26px;height:26px;display:inline-flex;align-items:center;justify-content:center;border-radius:9999px;border:none;background:rgba(0,0,0,0.045);color:#171717;cursor:pointer;transition:background 120ms ease}.ds-btn-icon:hover{background:rgba(0,0,0,0.08)}.ds-btn-icon:focus-visible{outline:none;box-shadow:0 0 0 2px #d3e5ff}"
    },
    {
      "name": "Search Input",
      "kind": "input",
      "refersTo": "input-search",
      "description": "대본 검색창.",
      "html": "<input class=\"ds-input-search\" placeholder=\"대본에서 찾기\">",
      "css": ".ds-input-search{font-family:-apple-system, \"Geist\", \"Inter\", \"Pretendard\", \"Apple SD Gothic Neo\", sans-serif;width:220px;font-size:12.5px;padding:6px 9px;border:1px solid #ebebeb;border-radius:6px;background:#fafafa;color:#171717}.ds-input-search:focus{outline:none;border-color:#0070f3;box-shadow:0 0 0 2px #d3e5ff}"
    },
    {
      "name": "Project Card",
      "kind": "card",
      "refersTo": "card-project",
      "description": "홈 화면의 영상 카드. 이름, 상태 배지, 메타 정보.",
      "html": "<div class=\"ds-card\"><div class=\"ds-card-top\"><span class=\"ds-card-name\">BS167</span><span class=\"ds-badge ds-badge-pending\">검토 중 · 25건 남음</span></div><div class=\"ds-card-meta\">오늘 14:29 · 56건 중 31건 결정</div></div>",
      "css": ".ds-card{font-family:-apple-system, \"Geist\", \"Inter\", \"Pretendard\", \"Apple SD Gothic Neo\", sans-serif;width:420px;background:#fafafa;border:1px solid #ebebeb;border-radius:12px;padding:14px 18px;cursor:pointer;transition:border-color 120ms ease,box-shadow 120ms ease}.ds-card:hover{border-color:#a1a1a1;box-shadow:0 6px 18px -10px rgba(0,0,0,0.18)}.ds-card-top{display:flex;align-items:center;justify-content:space-between;gap:10px}.ds-card-name{font-size:15px;font-weight:600;color:#171717}.ds-card-meta{margin-top:6px;font-size:12.5px;color:#666}.ds-badge{display:inline-flex;font-size:12px;font-weight:600;padding:3px 10px;border-radius:9999px;white-space:nowrap}.ds-badge-pending{background:#ffefcf;color:#ab570a}"
    },
    {
      "name": "Status Badges",
      "kind": "chip",
      "refersTo": "badge-pending",
      "description": "홈 화면 상태 배지: 검토 대기(호박), 확정(파랑), 처리 중(중립), 처리 실패(잉크 + 경고 아이콘).",
      "html": "<span class=\"ds-badge ds-badge-pending\">검토 중 · 12건 남음</span> <span class=\"ds-badge ds-badge-confirmed\">확정됨</span> <span class=\"ds-badge ds-badge-neutral\">처리 중</span> <span class=\"ds-badge ds-badge-failed\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M10.3 3.9 2.4 17.6A2 2 0 0 0 4.1 20.6h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z\"/><path d=\"M12 9v4.5\"/><path d=\"M12 17h.01\"/></svg>처리 실패</span>",
      "css": ".ds-badge{font-family:-apple-system, \"Geist\", \"Inter\", \"Pretendard\", \"Apple SD Gothic Neo\", sans-serif;display:inline-flex;font-size:12px;font-weight:600;padding:3px 10px;border-radius:9999px;white-space:nowrap}.ds-badge-pending{background:#ffefcf;color:#ab570a}.ds-badge-confirmed{background:#d3e5ff;color:#0058c0}.ds-badge-neutral{background:rgba(0,0,0,0.045);color:#666}.ds-badge{gap:5px;align-items:center}.ds-badge-failed{background:#171717;color:#fff}"
    },
    {
      "name": "Manuscript Marks",
      "kind": "custom",
      "refersTo": "",
      "description": "대본 위의 교정 기호 - 잘림(회색 취소선), 검토 대기(호박 배경), 선택(파랑 배경). 시스템의 정체성.",
      "html": "<p class=\"ds-ms\">그래서 오늘은 <span class=\"ds-cut\">어 그러니까 음</span> 수면 교육 연구 <span class=\"ds-query\">세 편을 세 편을</span> 같이 볼 건데요, <span class=\"ds-sel\">첫 번째 논문은</span> 2019년에 나왔습니다.</p>",
      "css": ".ds-ms{font-family:-apple-system, \"Geist\", \"Inter\", \"Pretendard\", \"Apple SD Gothic Neo\", sans-serif;max-width:520px;margin:0;font-size:17px;line-height:1.85;color:#171717}.ds-cut{color:#a1a1a1;text-decoration:line-through;text-decoration-color:#a1a1a1;cursor:pointer}.ds-query{background:#ffefcf;border-radius:3px}.ds-sel{background:#d3e5ff;border-radius:3px}"
    },
    {
      "name": "Modal",
      "kind": "custom",
      "refersTo": "modal",
      "description": "확정·오류·설정 같은 블로킹 창. 위쪽 드래그 핸들.",
      "html": "<div class=\"ds-modal\" role=\"dialog\"><div class=\"ds-handle\"></div><h2>확정할까요?</h2><p>아직 검토하지 않은 항목이 3곳 있습니다. 이대로 확정하면 3곳 모두 잘린 채로 나갑니다.</p><div class=\"ds-row\"><button class=\"ds-m-btn\">취소</button><button class=\"ds-m-btn ds-m-primary\">확정</button></div></div>",
      "css": ".ds-modal{font-family:-apple-system, \"Geist\", \"Inter\", \"Pretendard\", \"Apple SD Gothic Neo\", sans-serif;width:420px;background:#fff;border:1px solid #ebebeb;border-radius:14px;padding:22px 26px;line-height:1.6;color:#171717;box-shadow:0 24px 60px -14px rgba(0,0,0,0.25)}.ds-handle{height:12px;margin:-8px -12px 10px;display:flex;justify-content:center}.ds-handle::after{content:'';width:28px;height:3px;border-radius:2px;background:#ebebeb}.ds-modal h2{margin:0;font-size:16px}.ds-modal p{font-size:14px;color:#171717}.ds-row{display:flex;gap:8px}.ds-m-btn{font:inherit;font-size:13px;padding:7px 14px;border-radius:8px;border:1px solid #ebebeb;background:#fafafa;color:#171717;cursor:pointer}.ds-m-primary{background:#0070f3;border-color:#0070f3;color:#fff}"
    },
    {
      "name": "Toast",
      "kind": "custom",
      "refersTo": "toast",
      "description": "저장·되돌리기 알림. 페이지와 무관하게 항상 최대 대비.",
      "html": "<div class=\"ds-toast\" role=\"status\">되돌렸습니다</div>",
      "css": ".ds-toast{font-family:-apple-system, \"Geist\", \"Inter\", \"Pretendard\", \"Apple SD Gothic Neo\", sans-serif;display:inline-block;background:#171717;color:#fff;padding:9px 16px;border-radius:9px;font-size:13px}"
    },
    {
      "name": "Pipeline Progress",
      "kind": "custom",
      "refersTo": "",
      "description": "처리 진행 화면 - 제목, 숫자만 등폭인 부제, 그린 아이콘의 단계 목록, 동작 버튼.",
      "html": "<div class=\"ds-pp\"><h1 class=\"ds-pp-t\"><span class=\"ds-spin\"></span>처리 중</h1><p class=\"ds-pp-s\">NG 탐지 · <span class=\"n\">3</span>분 <span class=\"n\">18</span>초째 · <span class=\"n\">5/14</span>단계</p><ol class=\"ds-pp-l\"><li class=\"d\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#171717\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>전사</li><li class=\"a\"><span class=\"ds-spin sm\"></span>NG 탐지</li><li><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#a1a1a1\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"8\"/></svg>무음 리듬</li></ol><div class=\"ds-pp-a\"><button class=\"ds-pp-b\">일시정지</button><button class=\"ds-pp-b\">중단</button></div></div>",
      "css": ".ds-pp{font-family:-apple-system, \"Geist\", \"Inter\", \"Pretendard\", \"Apple SD Gothic Neo\", sans-serif;width:380px;display:flex;flex-direction:column;gap:14px;color:#171717}.ds-pp-t{margin:0;font-size:16px;font-weight:700;display:flex;align-items:center;gap:8px}.ds-pp-s{margin:-8px 0 0;font-size:13px;color:#666}.ds-pp-s .n{font-family:'Geist Mono',ui-monospace,Menlo,monospace;font-variant-numeric:tabular-nums}.ds-pp-l{list-style:none;margin:0;padding:12px 14px;display:flex;flex-direction:column;gap:8px;background:#fafafa;border:1px solid #ebebeb;border-radius:12px}.ds-pp-l li{display:flex;align-items:center;gap:10px;font-size:13.5px;color:#666}.ds-pp-l li.d{color:#171717}.ds-pp-l li.a{color:#171717;font-weight:600}.ds-spin{width:20px;height:20px;border:2.5px solid #d3e5ff;border-top-color:#0070f3;border-radius:50%;animation:ds-r .8s linear infinite;box-sizing:border-box}.ds-spin.sm{width:12px;height:12px;border-width:2px;margin:0 1px}@keyframes ds-r{to{transform:rotate(360deg)}}.ds-pp-a{display:flex;gap:8px}.ds-pp-b{font:inherit;font-size:13.5px;padding:8px 16px;border-radius:8px;border:1px solid #ebebeb;background:#fafafa;color:#171717;cursor:pointer}.ds-pp-b:hover{border-color:#a1a1a1}"
